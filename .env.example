# Supabase API URL (local: http://127.0.0.1:54321, cloud: https://<project>.supabase.co)
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Anon / publishable key (never the service role key)
VITE_SUPABASE_ANON_KEY=
# Public URL of the app, used in share links (local: http://localhost:5173)
VITE_APP_URL=http://localhost:5173
